{
  "name": "lobbyforge",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "postcss": "8.5.23",
      "browserslist": ">=4.28.7",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.10",
      "brace-expansion@<2": "^1.1.18",
      "brace-expansion@>=2 <3": "^2.0.3",
      "brace-expansion@>=3": "^5.0.9",
      "js-yaml@>=4 <5": "^4.3.2"
    }
  },
  "scripts": {
    "build:packages": "pnpm --filter @lobbyforge/config --filter @lobbyforge/core --filter @lobbyforge/plugin-sdk --filter @lobbyforge/bot-sdk --filter @lobbyforge/db --filter @lobbyforge/ui --filter @lobbyforge/registry -r --if-present build",
    "build:server": "pnpm build:packages && pnpm --filter @lobbyforge/ws-gateway build && pnpm --filter @lobbyforge/web build",
    "build:desktop": "pnpm --filter @lobbyforge/desktop build",
    "build": "pnpm build:server",
    "dev": "pnpm -r --if-present --parallel dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "lfctl": "node scripts/lfctl.mjs",
    "verify": "node scripts/verify.js",
    "i18n:status": "node scripts/i18n.mjs status",
    "i18n:sync": "node scripts/i18n.mjs sync",
    "i18n:add": "node scripts/i18n.mjs add",
    "i18n:complete": "node scripts/i18n.mjs complete"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.4",
    "@types/node": "^22.5.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.7.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
