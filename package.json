{
  "name": "lobbyforge",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "postcss": "8.5.15"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --if-present --parallel dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "lfctl": "node scripts/lfctl.mjs",
    "verify": "node scripts/verify.js"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.10",
    "@types/node": "^22.5.0",
    "eslint": "^9.4.0",
    "eslint-config-next": "^16.2.10",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.7.0",
    "vitest": "^1.6.0"
  }
}
