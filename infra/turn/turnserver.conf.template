# coturn TURN server — LobbyForge production (LF-019).
#
# TEMPLATE: scripts/render-configs.sh renders this to the sibling
# turnserver.conf with LOBBYFORGE_DOMAIN and TURN_CREDENTIAL substituted.
# The rendered file is git-ignored.
#
# Firewall requirements (host network — coturn binds directly):
#   3478/tcp + 3478/udp   TURN listening port
#   5349/tcp + 5349/udp   TURN/TLS (falls back to TCP+TLS when UDP is blocked)
#   49160-49200/udp       relay range (one port per relayed media stream)

listening-port=3478
tls-listening-port=5349

# Authentication: REST API auth (VOICE-001) — TIME-LIMITED HMAC
# credentials instead of a static user table. The web app derives
#   username   = `${unixExpiry}:${userId}`
#   credential = base64(HMAC-SHA1(STATIC_SECRET, username))
# and hands one to each voice client alongside its LiveKit token (1h,
# matching the token TTL). coturn rejects expired usernames on new
# allocations, so a leaked credential is useless after its hour and
# `user-quota` counts allocations per USER again (suffix = user id).
# STATIC_SECRET is substituted by scripts/render-configs.sh from
# LOBBYFORGE_TURN_SECRET in .env.prod — the SAME secret the web app
# reads to mint credentials.
lt-cred-mech
use-auth-secret
static-auth-secret=TURN_SECRET
realm=LOBBYFORGE_DOMAIN

# TLS certificates (shared with nginx via the certbot volume).
cert=/etc/letsencrypt/live/LOBBYFORGE_DOMAIN/fullchain.pem
pkey=/etc/letsencrypt/live/LOBBYFORGE_DOMAIN/privkey.pem
no-tlsv1
no-tlsv1_1

# Relay port range — keep in sync with the firewall checklist above.
min-port=49160
max-port=49200

# Resource limits. VOICE-001: with REST auth every user connects under a
# DISTINCT username (suffix = user id), so user-quota is per-user again —
# 8 covers one client's udp+tcp+tls candidates with headroom.
total-quota=240
user-quota=8
stale-nonce=600

# Hardening: refuse to relay to non-routable space. V5-003: coturn runs
# in the HOST network namespace, so without these denys a member holding
# the TURN credential could pivot to the Docker bridge / VPC private
# ranges (10/8, 172.16/12, 192.168/16) and carrier-grade NAT space.
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=::1
no-cli

# V5-003: behind 1:1 NAT (cloud VM with a private interface) the public
# address must be set explicitly. install.sh prompts for it and stores
# it in .env.prod (LOBBYFORGE_TURN_EXTERNAL_IP); the render script
# substitutes this placeholder (auto-detect when unset).
@TURN_EXTERNAL_IP_LINE@

log-file=stdout
simple-log
