# LiveKit production configuration.
#
# Replace LOBBYFORGE_DOMAIN with your domain. The RTC port range (50000-60000/udp)
# must be open on the firewall. TURN is optional but recommended for restrictive
# networks.

port: 7880
bind_addresses:
  - "0.0.0.0"

rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true
  # VOICE-002: `enable_loopback_reflection` was REMOVED in livekit
  # 1.13 — keeping it crash-loops the server on config parse ("field
  # enable_loopback_reflection not found in type config.RTCConfig").
  # Loopback candidates are not reflected by default in 1.13+, which is
  # the same hardening the old flag expressed.
  # LF-019 + VOICE-001: TURN fallback is the standalone coturn container
  # (see the `turn` service in docker-compose.prod.yml), but LiveKit does
  # NOT advertise it here anymore. rtc.turn_servers only accepts a STATIC
  # username/credential, which meant handing ONE permanent relay
  # credential to every community member in the connect response. The web
  # app now mints per-user, time-limited coturn REST-auth credentials
  # (LOBBYFORGE_TURN_SECRET) alongside each LiveKit token and clients
  # apply them via rtcConfig.iceServers — ICE still tries direct/STUN
  # paths first, so behavior on open networks is unchanged.
  # DO NOT re-add a static turn_servers block here.

keys:
  # Set via LIVEKIT_KEYS env var in docker-compose (format: "key: secret")

# NOTE: LiveKit's built-in `turn:` block is intentionally NOT used — it
# provisions its own certificates and would fight the stack's certbot.
# The standalone coturn container + app-minted ephemeral credentials
# (VOICE-001, see the rtc comment above) is the supported TURN path.

logging:
  level: info
  json: false

room:
  auto_create: true
  # beta-review: never let the server API switch a participant's mic ON —
  # a moderator "unmute" only re-allows publishing (canPublishSources).
  enable_remote_unmute: false
  empty_timeout: 300

# security-review AUTHZ-006 follow-up: LiveKit checks only the SOURCE a
# track claims (camera, microphone, …), never its kind — a server-muted
# member could publish their microphone as "camera" and be heard. LiveKit
# posts its room events to the web app, which on track_published removes
# a participant whose track kind does not match its source
# (apps/web/app/api/livekit/webhook). The web service is reached over the
# compose network; nginx 404s this path at the public edge.
# api_key must NAME one of the configured keys (LIVEKIT_KEYS) — it is
# random per install, so scripts/render-configs.sh fills it in from
# LIVEKIT_WEBHOOK_API_KEY (install.sh passes LIVEKIT_API_KEY). Rendered
# without it, the block stays commented out (webhook disabled).
webhook:
  @LIVEKIT_WEBHOOK_API_KEY_LINE@
  @LIVEKIT_WEBHOOK_URLS_LINE@
