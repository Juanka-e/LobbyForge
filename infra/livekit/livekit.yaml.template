# LiveKit production configuration.
#
# Replace LOBBYFORGE_DOMAIN with your domain. The RTC port range (50000-60000/udp)
# must be open on the firewall. TURN is optional but recommended for restrictive
# networks.

port: 7880
bind_addresses:
  - "0.0.0.0"

rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true
  enable_loopback_reflection: false
  # LF-019: standalone coturn fallback (see the `turn` service in
  # docker-compose.prod.yml). LiveKit hands these entries to clients in
  # the connect response; they are tried only after direct/STUN paths
  # fail, so voice works behind symmetric NATs and UDP-blocking
  # networks. TURN_CREDENTIAL matches turnserver.conf's static user and
  # is substituted by scripts/render-configs.sh.
  turn_servers:
    - host: LOBBYFORGE_DOMAIN
      port: 3478
      protocol: udp
      username: lobbyforge
      credential: TURN_CREDENTIAL
    - host: LOBBYFORGE_DOMAIN
      port: 3478
      protocol: tcp
      username: lobbyforge
      credential: TURN_CREDENTIAL
    # V4-005: coturn also listens with TLS on 5349 — advertise it, or
    # clients never learn the TLS fallback exists (the listener alone is
    # not an ICE candidate). Note: networks that only allow outbound
    # 443/tcp still need extra design (see docs/VOICE_TURN.md) because
    # nginx already holds 443 on this host.
    - host: LOBBYFORGE_DOMAIN
      port: 5349
      protocol: tls
      username: lobbyforge
      credential: TURN_CREDENTIAL

keys:
  # Set via LIVEKIT_KEYS env var in docker-compose (format: "key: secret")

# NOTE: LiveKit's built-in `turn:` block is intentionally NOT used — it
# provisions its own certificates and would fight the stack's certbot.
# The standalone coturn container + rtc.turn_servers above is the
# supported TURN path.

logging:
  level: info
  json: false

room:
  auto_create: true
  enable_remote_unmute: true
  empty_timeout: 300

webhook:
  # api_key: your-key  # Set if you use webhooks
