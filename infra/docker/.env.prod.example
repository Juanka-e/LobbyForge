# LobbyForge production environment — copy to .env.prod and edit.
# Or run install.sh to generate automatically.

# PostgreSQL
POSTGRES_DB=lobbyforge
POSTGRES_USER=lobbyforge
POSTGRES_PASSWORD=CHANGE_ME_strong_password
DATABASE_URL=postgres://lobbyforge:CHANGE_ME_strong_password@postgres:5432/lobbyforge

# Redis
REDIS_PASSWORD=CHANGE_ME_strong_password

# LiveKit
LIVEKIT_API_KEY=CHANGE_ME_api_key
LIVEKIT_API_SECRET=CHANGE_ME_64_char_secret
LIVEKIT_URL=http://livekit:7880
NEXT_PUBLIC_LIVEKIT_URL=wss://lobby.example.com/livekit
NEXT_PUBLIC_WS_URL=wss://lobby.example.com/ws

# Security (generate with: openssl rand -hex 32)
LOBBYFORGE_SESSION_SECRET=CHANGE_ME_64_char_hex
LOBBYFORGE_ADMIN_TOKEN=CHANGE_ME_64_char_hex
LOBBYFORGE_SETUP_TOKEN=CHANGE_ME_64_char_hex

# Product shape
LOBBYFORGE_DEPLOYMENT_MODE=self_host
LOBBYFORGE_INSTANCE_NAME=LobbyForge Community
NEXT_PUBLIC_BASE_URL=https://lobby.example.com

# Node
NODE_ENV=production
