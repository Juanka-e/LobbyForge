# LobbyForge production environment — copy to .env.prod and edit.
# Or run install.sh to generate automatically.
#
# REQUIRED by docker-compose.prod.yml — the compose file refuses to
# start without these (11th-audit sync; install.sh generates all of
# them automatically).

# PostgreSQL
POSTGRES_DB=lobbyforge
POSTGRES_USER=lobbyforge
POSTGRES_PASSWORD=CHANGE_ME_strong_password
DATABASE_URL=postgres://lobbyforge:CHANGE_ME_strong_password@postgres:5432/lobbyforge

# Redis
REDIS_PASSWORD=CHANGE_ME_strong_password

# LiveKit
LIVEKIT_API_KEY=CHANGE_ME_api_key
LIVEKIT_API_SECRET=CHANGE_ME_64_char_secret
LIVEKIT_URL=http://livekit:7880
NEXT_PUBLIC_LIVEKIT_URL=wss://lobby.example.com/livekit
NEXT_PUBLIC_WS_URL=wss://lobby.example.com/ws

# TURN (coturn) — hex, 32-128 chars. NOTE the name the web app reads
# is LOBBYFORGE_TURN_SECRET (install.sh generates exactly this); the
# render script substitutes it into turnserver.conf too.
LOBBYFORGE_TURN_SECRET=CHANGE_ME_64_char_hex

# Plugin worker isolation (required by compose; unused until
# LOBBYFORGE_DYNAMIC_PLUGINS_ENABLED=true, but must exist)
LOBBYFORGE_PLUGIN_WORKER_TOKEN=CHANGE_ME_64_char_hex
LOBBYFORGE_PLUGIN_STORAGE_TOKEN=CHANGE_ME_64_char_hex

# Certificate issuance
ACME_EMAIL=admin@example.com
LOBBYFORGE_DOMAIN=lobby.example.com

# Security (generate with: openssl rand -hex 32)
LOBBYFORGE_SESSION_SECRET=CHANGE_ME_64_char_hex
LOBBYFORGE_ADMIN_TOKEN=CHANGE_ME_64_char_hex
LOBBYFORGE_SETUP_TOKEN=CHANGE_ME_64_char_hex

# Product shape
LOBBYFORGE_DEPLOYMENT_MODE=self_host
LOBBYFORGE_INSTANCE_NAME=LobbyForge Community
NEXT_PUBLIC_BASE_URL=https://lobby.example.com

# Trusted proxy — REQUIRED in production behind nginx: the app only
# honors X-Forwarded-For when this is set (nginx overwrites the header
# with the real client address). Keep x-forwarded-for behind Cloudflare
# too (with infra/nginx/conf.d/cf-real-ip.conf); "cloudflare" is only safe
# when the origin accepts traffic from Cloudflare alone.
LOBBYFORGE_TRUSTED_PROXY=x-forwarded-for

# Bot protection (docs/CAPTCHA.md). Sign-up and new guests solve a small
# built-in ALTCHA proof of work by default; sign-in asks only when it looks
# suspicious. Configure it in Admin → Settings → Authentication → Bot
# protection. These override that screen (and show as locked there);
# LOBBYFORGE_CAPTCHA_PROVIDER=none switches protection off in an emergency.
# LOBBYFORGE_CAPTCHA_PROVIDER=altcha          # none | altcha | turnstile | recaptcha
# LOBBYFORGE_CAPTCHA_SITE_KEY=
# LOBBYFORGE_CAPTCHA_SECRET_KEY=

# Email (docs/EMAIL.md): verification codes and links, email change and
# password reset, sent through an SMTP relay (Amazon SES, Scaleway TEM, Brevo,
# SMTP2GO, Resend, Mailjet, Mailgun — or your own server). Normally set in
# Admin → Settings → Email, with a test button; these override that screen
# (and show as locked there). Nothing changes until mail is configured:
# verification starts `off` and password reset says "ask your administrator".
# Many VPS block port 25 (and Hetzner 465): use 587, or 2525 / 2587 where the
# provider offers it. Add the provider's SPF, DKIM and DMARC records to the
# From domain, or mail lands in spam.
# LOBBYFORGE_MAIL_PROVIDER=ses                # preset id, or none
# LOBBYFORGE_SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
# LOBBYFORGE_SMTP_PORT=587
# LOBBYFORGE_SMTP_SECURITY=starttls           # tls | starttls
# LOBBYFORGE_SMTP_USER=                       # SES: the SMTP user name, not an AWS access key
# LOBBYFORGE_SMTP_PASSWORD=                   # never stored, never shown; set the HOST and USER here too —
#                                             the admin screen cannot point an env password at a host
# LOBBYFORGE_MAIL_FROM="LobbyForge <no-reply@your-domain.com>"
# LOBBYFORGE_EMAIL_VERIFICATION=optional      # off | optional | required; off is the emergency switch

# Absolute session lifetime in days (default 30): no session — signed-in
# or guest — is refreshed past this long after it was issued.
# LOBBYFORGE_SESSION_MAX_AGE_DAYS=30

# Node
NODE_ENV=production

# MANUAL DEPLOY NOTE: nginx, LiveKit and coturn configs are RENDERED
# from tracked templates (git-ignored output). Before `docker compose
# up`, run:
#   LIVEKIT_WEBHOOK_API_KEY=<LIVEKIT_API_KEY> \
#     bash scripts/render-configs.sh <domain> <turn-secret-hex>
# (the key enables LiveKit's webhook to the web app — without it the
# webhook block renders disabled). install.sh does this automatically.
