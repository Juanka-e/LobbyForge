# LobbyForge dev stack — copy to .env and adjust.

# PostgreSQL
POSTGRES_DB=lobbyforge
POSTGRES_USER=lobbyforge
POSTGRES_PASSWORD=lobbyforge_dev

# Redis
REDIS_PASSWORD=lobbyforge_dev

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_please_change

# Optional (only used when starting the `full` profile)
MINIO_ROOT_USER=lobbyforge
MINIO_ROOT_PASSWORD=lobbyforge_dev
COTURN_STATIC_AUTH_SECRET=turn_dev_secret

# --- Web app (apps/web) ---
# HMAC secret used to sign the lf_guest session cookie. MUST be at least 32 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOBBYFORGE_SESSION_SECRET=replace_me_with_at_least_32_chars_of_random_hex
# One-time first-owner claim secret. Production setup refuses to run without it.
# Generate independently from the session secret and remove/rotate it after setup.
LOBBYFORGE_SETUP_TOKEN=replace_me_with_at_least_32_chars_of_random_hex

# Runtime product shape. Self-host is the secure default and does not expose
# official-hub instance creation/catalog surfaces.
LOBBYFORGE_DEPLOYMENT_MODE=self_host
LOBBYFORGE_INSTANCE_NAME=LobbyForge Community

# Google OAuth (optional — enables "Continue with Google" on the login page).
# Get credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/oauth/google/callback

# Production rate limiting uses Redis by default. Set the proxy mode only when
# that trusted proxy strips and replaces the corresponding client IP header.
# LOBBYFORGE_RATE_LIMIT_STORE=redis
# LOBBYFORGE_TRUSTED_PROXY=x-forwarded-for

# Postgres connection string consumed by apps/web (lib/db.ts). The default
# points at the local docker-compose dev stack; override for staging/prod.
DATABASE_URL=postgres://lobbyforge:lobbyforge_dev@localhost:5432/lobbyforge

# Optional pool tuning. Defaults: 10 connections, no SSL.
# DATABASE_POOL_MAX=10
# DATABASE_SSL=false

# Doctor HTTP probes default to the dev stack. Uncomment to override.
# LIVEKIT_URL=http://localhost:7880
#
# Browser-side LiveKit URL (used by /room/[roomName] to call Room.connect()).
# Default points at the dev stack.
# NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
# POSTGRES_URL=postgres://lobbyforge:lobbyforge_dev@localhost:5432/lobbyforge
# REDIS_URL=redis://:lobbyforge_dev@localhost:6379
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
#
# LOBBYFORGE_DISK_USAGE_RATIO is a 0..1 ratio used by Doctor's disk check
# until a real /proc + df integration lands.
# LOBBYFORGE_DISK_USAGE_RATIO=0.5
#
# LOBBYFORGE_TURN_URL and LOBBYFORGE_TURN_STATIC_AUTH_SECRET are the TURN
# credentials. Both must be set for the Doctor's turn_configured check to
# pass.
# LOBBYFORGE_TURN_URL=turn:turn.example.com:3478
# LOBBYFORGE_TURN_STATIC_AUTH_SECRET=turn_dev_secret
