{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LobbyForge",
  "version": "0.1.0",
  "identifier": "dev.lobbyforge.desktop",
  "build": {
    "frontendDist": "../dist-shell",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LobbyForge",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: https://ipc.localhost; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://* wss://* ws://*; media-src 'self' blob: https:; frame-src 'none'; object-src 'none'"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "LobbyForge"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "LobbyForge contributors",
    "copyright": "Copyright © 2026 LobbyForge contributors. AGPL-3.0-only.",
    "homepage": "https://lobbyforge.org",
    "license": "AGPL-3.0-only",
    "category": "SocialNetworking",
    "shortDescription": "Voice-first community client for self-hosted LobbyForge servers",
    "longDescription": "LobbyForge is the desktop client for LobbyForge, a voice-first, self-hostable community platform with live in-room activities. Enter your server's address on first launch; the same installer works with every LobbyForge server, and there is no central account.",
    "windows": {
      "nsis": {
        "template": "installer/nsis/installer.nsi",
        "installMode": "currentUser",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": false,
        "installerIcon": "installer/installer.ico",
        "uninstallerIcon": "installer/installer.ico",
        "headerImage": "installer/nsis/header.bmp",
        "uninstallerHeaderImage": "installer/nsis/header.bmp",
        "sidebarImage": "installer/nsis/sidebar.bmp"
      },
      "wix": {
        "bannerPath": "installer/wix/banner.bmp",
        "dialogImagePath": "installer/wix/dialog.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "lobbyforge"
        ]
      }
    }
  }
}
