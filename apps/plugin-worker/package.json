{
  "name": "@lobbyforge/plugin-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc && rm -f dist/executor.mjs dist/executor-child.mjs && node -e \"['sandbox-core.mjs','sandbox-thread.mjs'].forEach(f=>require('fs').copyFileSync('src/'+f,'dist/'+f))\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@lobbyforge/plugin-sdk": "workspace:*",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@lobbyforge/config": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.5",
    "vitest": "^5.0.3"
  }
}
