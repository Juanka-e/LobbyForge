{
  "name": "@lobbyforge/plugin-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc && rm -f dist/executor.mjs && node -e \"['executor-child.mjs'].forEach(f=>require('fs').copyFileSync('src/'+f,'dist/'+f))\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@lobbyforge/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@lobbyforge/config": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.5",
    "vitest": "^5.0.1"
  }
}
