{
  "name": "@lobbyforge/ws-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\"",
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@lobbyforge/core": "workspace:*",
    "@lobbyforge/db": "workspace:*",
    "ioredis": "^5.4.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@lobbyforge/config": "workspace:*",
    "@types/ws": "^8.5.12",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}